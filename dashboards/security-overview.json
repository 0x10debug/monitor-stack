          "editorMode": "code",
          "expr": "sum by (a0) (count_over_time({job=\"auditd\"} |~ \"type=EXECVE\" [5m]))",
          "legendFormat": "{{a0}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "特权命令执行",
      "type": "timeseries"
