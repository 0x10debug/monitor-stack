          "editorMode": "code",
          "expr": "sum by (country) (count_over_time({job=\"crowdsec\"} | json | __error__=\"\" [1h]))",
          "legendFormat": "{{country}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "封禁 IP 地理分布",
      "type": "geomap"
