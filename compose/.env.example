# monitor-stack environment configuration
# Copy to .env and fill in values before deploying.

# ─── Required ────────────────────────────────────────────────
# Domain for the monitoring dashboard (used by Caddy reverse proxy)
MONITOR_DOMAIN=

# ─── Optional ────────────────────────────────────────────────
# External proxy network name (must match your Caddy/reverse-proxy setup)
# MB_PROXY_NETWORK=mb-proxy

# Host ports for the monitoring services
# UPTIME_KUMA_PORT=3001
# BESZEL_HUB_PORT=8090

# ─── CrowdSec (compose/crowdsec.yml) ──────────────────────────
# Bouncer registration key. Generate with:
#   docker exec crowdsec cscli bouncers add mb-firewall -o raw
# Paste the returned key here.
CROWDSEC_BOUNCER_KEY=
# Local API port (bound to 127.0.0.1 only).
# CROWDSEC_LAPI_PORT=8080
# Detection collections to install (space-separated).
# CROWDSEC_COLLECTIONS=crowdsecurity/linux
