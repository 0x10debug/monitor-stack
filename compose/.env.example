# monitor-stack environment configuration
# Copy to .env and fill in values before deploying.

# ─── Required ────────────────────────────────────────────────
# Domain for the monitoring dashboard (used by Caddy reverse proxy)
MONITOR_DOMAIN=

# ─── Optional ────────────────────────────────────────────────
# External proxy network name (must match your Caddy/reverse-proxy setup)
# MB_PROXY_NETWORK=mb-proxy

# Host ports for the monitoring services
# UPTIME_KUMA_PORT=3001
# BESZEL_HUB_PORT=8090

# ─── CrowdSec (compose/crowdsec.yml) ──────────────────────────
# Bouncer registration key. Generate with:
#   docker exec crowdsec cscli bouncers add mb-firewall -o raw
# Paste the returned key here.
CROWDSEC_BOUNCER_KEY=
# Local API port (bound to 127.0.0.1 only).
# CROWDSEC_LAPI_PORT=8080
# Detection collections to install (space-separated).
# CROWDSEC_COLLECTIONS=crowdsecurity/linux

# ─── Loki + Promtail (compose/loki.yml) ─────────────────────────
# Loki HTTP API port (bound to 127.0.0.1 only; Grafana reaches it over
# the shared Docker network).
# LOKI_PORT=3100
# Log retention window. Tune to match your disk budget. Examples:
#   336h  = 14 days (default)
#   720h  = 30 days
#   0s    = disable retention (not recommended)
# To override at runtime, run Loki with -config.expand-env=true and set
# this variable; otherwise the value in agents/loki-config.yml is used.
# LOKI_RETENTION=336h

# ─── Blackbox Exporter (compose/blackbox.yml) ──────────────────
# Blackbox Exporter HTTP API port (bound to 127.0.0.1 only; Prometheus
# reaches it over the shared Docker network).
# BLACKBOX_PORT=9115

# ─── Grafana (compose/grafana.yml) ─────────────────────────────
# Grafana HTTP UI port (bound to 127.0.0.1 only; put a reverse proxy
# in front for TLS and domain routing).
# GRAFANA_PORT=3000
# Initial admin password. Set once on first boot; change via Grafana UI
# afterwards. Required when deploying compose/grafana.yml.
GF_SECURITY_ADMIN_PASSWORD=

# ─── Alertmanager (compose/alertmanager.yml) ───────────────────
# Alertmanager web UI + API port (bound to 127.0.0.1 only; Prometheus
# reaches it over the shared Docker network).
# ALERTMANAGER_PORT=9093
# Slack incoming webhook URL. Create at https://api.slack.com/apps →
# your app → Incoming Webhooks. Used by alerts/alertmanager-rules.yml.
SLACK_WEBHOOK_URL=
# Discord webhook URL. Create in Discord → Channel Settings →
# Integrations → Webhooks. Alertmanager appends /slack for Slack-compat
# mode. Used by alerts/alertmanager-rules.yml.
DISCORD_WEBHOOK_URL=
# Telegram bot token from @BotFather and target chat ID. These are
# consumed by the Telegram relay container (not Alertmanager directly).
# Alertmanager sends alerts to the relay via RELAY_URL, which renders the
# template and posts to the Telegram Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram relay URL. Points to your Telegram-Alertmanager bridge
# container. Adjust if your relay runs on a different host/port.
# RELAY_URL=http://telegram-relay:8080/alertmanager
